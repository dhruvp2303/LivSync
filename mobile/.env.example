# LivSync Environment Configuration Example
# Copy this file to .env and insert your project credentials when linking live Firebase

# Firebase Project Configuration
FIREBASE_PROJECT_ID="livsync-app"
FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
FIREBASE_APP_ID="1:1234567890:android:abcdef"
FIREBASE_MESSAGING_SENDER_ID="1234567890"
FIREBASE_STORAGE_BUCKET="livsync-app.appspot.com"

# Application Settings
APP_NAME="LivSync"
USE_MOCK_DATA=true
